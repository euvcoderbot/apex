{
  "name": "euv2-data-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node scripts/start-local.mjs",
    "local:precompute": "node scripts/precompute-local.mjs",
    "local:warm": "node scripts/precompute-local.mjs --season",
    "local:export-session": "node scripts/export-local-session.mjs",
    "site:prepare": "node scripts/prepare-site-update.mjs",
    "site:warm": "node scripts/warm-hosted.mjs",
    "prerender": "node scripts/prerender.mjs",
    "sync:apex": "node scripts/sync-static.mjs",
    "predev": "npm run sync:apex",
    "dev": "vinext dev",
    "prebuild": "npm run sync:apex",
    "build": "vinext build",
    "start": "vinext start",
    "site:sync-prepared": "node scripts/sync-prepared-sessions.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test",
    "test:py": "node scripts/run-python-tests.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual --project=chromium"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "react-server-dom-webpack": "^19.3.1",
    "typescript": "5.9.3",
    "vinext": "^1.4.0",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3",
    "minimatch": "11.0.1"
  }
}
